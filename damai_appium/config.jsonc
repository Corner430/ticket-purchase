{
  "server_url": "http://127.0.0.1:4723",
  // device_name: 目标设备序列号。留 "auto" 时自动探测唯一连接的设备；
  //              多台设备同时连接时，填 `adb devices` 里的某个序列号来指定
  "device_name": "auto",
  "users": [
    "王胜",
    "潘鸿运"
  ],
  "city": "深圳",
  // price_index: 票价档位索引（从 0 开始）。用 Appium Inspector 看票价列表数出目标是第几个
  "price_index": 5,
  // if_commit_order: 是否真实提交订单。false=调试不下单（安全默认），true=真实下单
  "if_commit_order": false
}
